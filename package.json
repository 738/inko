{
  "name": "inko",
  "version": "1.1.2",
  "description": "영타를 한글로 쳤을 때, 혹은 한타를 영어로 변환해주는 기능을 가진 자바스크립트 오픈소스 라이브러리입니다.",
  "bugs": {
    "url": "https://github.com/738/inko/issues",
    "email": "jydrogen@gmail.com"
  },
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.js",
    "build": "node scripts/build.cjs",
    "check:package": "node scripts/check-package.cjs",
    "verify": "npm test && npm run build && npm run check:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "prettier": "prettier --write ."
  },
  "keywords": [
    "inko",
    "korean",
    "english",
    "convert",
    "converter",
    "korea",
    "잉꼬",
    "한글",
    "영타",
    "한타",
    "영어",
    "변환",
    "한영타변환"
  ],
  "engines": {
    "node": ">= 0.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/738/inko.git"
  },
  "author": "Jon Jee",
  "license": "MIT",
  "homepage": "https://inko.js.org",
  "devDependencies": {
    "prettier": "^3.9.8",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "inko.min.js",
    "inko.min.js.map",
    "CHANGELOG.md"
  ]
}
